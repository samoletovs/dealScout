# dealScout email is sent via the shared `courier` service (Azure Communication
# Services). Set these as GitHub secrets; the recipient must be on courier's allowlist.
COURIER_URL=https://func-courier-xxxx.azurewebsites.net/api/send
COURIER_KEY=your-courier-function-key
DEALSCOUT_EMAIL_TO=you@example.com

# Newsletter inbox (IMAP) — the dedicated Gmail was disabled by Google (2026-07); the
# newsletter source is being re-homed. Placeholder only, no automation account here.
DEALSCOUT_IMAP_HOST=imap.example.com
DEALSCOUT_IMAP_USER=your-newsletter-inbox
DEALSCOUT_IMAP_PASS=your-app-password

# Google Shopping scan (SerpApi) — optional, opt-in. Get a key at serpapi.com (free
# tier ~250 searches/month). Leave unset to keep the scan dormant.
SERPAPI_KEY=your-serpapi-key
