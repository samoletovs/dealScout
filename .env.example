# dealScout email (SMTP) — copy to .env and fill. NEVER commit real values.
DEALSCOUT_SMTP_HOST=smtp.example.com
DEALSCOUT_SMTP_PORT=587
DEALSCOUT_SMTP_USER=your-smtp-user
DEALSCOUT_SMTP_PASS=your-smtp-password
DEALSCOUT_EMAIL_TO=you@example.com

# Newsletter inbox (Gmail IMAP) — use a Gmail App Password, never your login. Never commit.
DEALSCOUT_IMAP_HOST=imap.gmail.com
DEALSCOUT_IMAP_USER=deal.scout.radar@gmail.com
DEALSCOUT_IMAP_PASS=your-gmail-app-password
